{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build raylib game",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                "main.cpp",
                "src/player.cpp",
                "src/camera_controller.cpp",
                "src/scene_renderer.cpp",
                "src/shader_system.cpp",
                "-lraylib",
                "-lGL",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt",
                "-lX11",
                "-o",
                "main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build all raylib game modules."
        }
    ],
    "version": "2.0.0"
}